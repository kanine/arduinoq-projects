{
  "webhook_url": "https://your.webhook/endpoint",
  "host": "my-sensor-node",

  "polling": {
    "polls_per_minute": 300,
    "batch_cap": 50
  },

  "sensor": {
    "distance_mode": "Short",
    "timing_budget_ms": 50,
    "inter_measurement_ms": 50,
    "roi_width": 16,
    "roi_height": 16,
    "roi_center": 199
  }
}
